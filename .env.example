DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bookline"

# Generate with: openssl rand -base64 32
JWT_SECRET=""

# LINE Messaging API channel access token (long-lived), from the LINE Developers console
LINE_CHANNEL_ACCESS_TOKEN=""

# The LINE userId that should receive the admin push notification (add the bot as a friend
# and grab your own userId from the webhook, or the LINE Developers "Basic settings" test target)
LINE_USER_ID=""

# LINE Login channel (LINE Developers console -> your LINE Login channel -> Basic settings).
# This channel MUST be linked to the same LINE Official Account as LINE_CHANNEL_ACCESS_TOKEN
# above ("Linked LINE Official Account" setting), otherwise the userId LINE Login returns won't
# match the Messaging API's userId space and pushes to individual users will silently fail.
LINE_LOGIN_CHANNEL_ID=""
LINE_LOGIN_CHANNEL_SECRET=""

# Must exactly match a Callback URL registered on the LINE Login channel
LINE_LOGIN_REDIRECT_URI="http://localhost:3000/api/line/callback"
